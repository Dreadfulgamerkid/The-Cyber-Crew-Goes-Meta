# META_API_KEY: Required for Meta Model API calls (https://api.meta.ai/v1).
# Get a key from https://dev.meta.ai/ and set it here or in .env.local.
# MODEL_API_KEY is also accepted as a fallback name.
META_API_KEY="MY_META_API_KEY"

# Optional overrides (defaults shown):
# META_API_BASE_URL="https://api.meta.ai/v1"
# META_MODEL="muse-spark-1.2"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
